[Unit]
Description=BirdStream camera service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run service as the local user that owns the repository. Adjust if you use a different account.
User=admin
WorkingDirectory=/home/admin/BirdStream/raspberry-pi
ExecStart=/home/admin/BirdStream/raspberry-pi/venv/bin/python /home/admin/BirdStream/raspberry-pi/src/main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
